// #include <dt-bindings/zmk/rgb.h>

#define ZMK_POINTING_DEFAULT_MOVE_VAL 2500// 600
#define ZMK_POINTING_DEFAULT_SCRL_VAL 20// 10

#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/pointing.h>

#include "behaviors/character_map.dtsi"
#include "behaviors/report.dtsi"


#define MAC 0
#define WIN 1
#define RIG 2
#define LEF 3
#define TRI 4
#define MOUSE 5

#define SPEED_POINTER 0
#define SPEED_SCROLL 1
#define SPEED_PREV 0
#define SPEED_NEXT 1
#define SPEED_RESET 2
#define SPEED_FINE_PREV 3
#define SPEED_FINE_NEXT 4
#define CIRQUE_MODE_RELATIVE 0
#define CIRQUE_MODE_ABSOLUTE 1
#define CIRQUE_MODE_TOGGLE 2


&sensors {
	left_encoder {
		triggers-per-rotation = <15>;
	};
	right_encoder {
		triggers-per-rotation = <45>;
	};
};

&glidepoint_listener {
	input-processors = <&pointer_processor 0 0 &drag_scroll_processor 1 8>;
};

/ {
	pointer_processor: pointer_processor {
		compatible = "zmk,input-processor-pointer-speed";
		#input-processor-cells = <2>;
		track-remainders;
		pointer-curve = "adaptive";
		pointer-curve-deadzone = <2>;
		pointer-curve-accel-multiplier = <1>;
		pointer-curve-accel-divisor = <12>;
		pointer-curve-max-delta = <120>;
		one-x-multiplier = <1>;
		one-x-divisor = <1>;
		min-percent = <10>;
		max-percent = <400>;
		initial-speed-position = <50>;
	};
	
	drag_scroll_processor: drag_scroll_processor {
		compatible = "zmk,input-processor-drag-scroll";
		#input-processor-cells = <2>;
		track-remainders;
		native-wheel-axis = "horizontal-when-enabled";
		scroll-min-step = <1>;
		one-x-multiplier = <1>;
		one-x-divisor = <1>;
		min-percent = <10>;
		max-percent = <1000>;
		initial-speed-position = <50>;
	};
	
	behaviors {
		drgscrl: drag_scroll {
			compatible = "zmk,behavior-drag-scroll";
			#binding-cells = <0>;
		};
	
		ptr_spd: pointing_speed {
			compatible = "zmk,behavior-pointing-speed";
			#binding-cells = <2>;
		};

		enc_ptr_spd: encoder_pointer_speed {
			compatible = "zmk,behavior-sensor-rotate";
			#sensor-binding-cells = <0>;
			bindings = <&ptr_spd SPEED_POINTER SPEED_PREV>, <&ptr_spd SPEED_POINTER SPEED_NEXT>;
		};

		enc_scrl_spd: encoder_scroll_speed {
			compatible = "zmk,behavior-sensor-rotate";
			#sensor-binding-cells = <0>;
			bindings = <&ptr_spd SPEED_SCROLL SPEED_PREV>, <&ptr_spd SPEED_SCROLL SPEED_NEXT>;
		};

		crq_mode: crqm {
			compatible = "zmk,behavior-cirque-mode";
			#binding-cells = <1>;
		};

		sel_x: select_x {
			compatible = "zmk,behavior-hold-tap";
			#binding-cells = <2>;
			flavor = "tap-preferred";
			tapping-term-ms = <200>;
			quick-tap-ms = <150>;
			require-prior-idle-ms = <125>;
			bindings = <&mkp>, <&kp>;
		};
		
		ds_z: drag_scroll_z {
			compatible = "zmk,behavior-hold-tap";
			#binding-cells = <2>;
			flavor = "tap-preferred";
			tapping-term-ms = <200>;
			quick-tap-ms = <150>;
			require-prior-idle-ms = <125>;
			bindings = <&drgscrl>, <&kp>;
		};

		ht: hold_tap {
			label = "hold_tap";
			compatible = "zmk,behavior-hold-tap";
			#binding-cells = <2>;
			flavor = "balanced";
			tapping-term-ms = <200>;
			quick-tap-ms = <150>;
			require-prior-idle-ms = <125>;
			global-quick-tap;
			bindings = <&kp>, <&kp>;
		};
		mmv {
			acceleration-exponent = <1>;// 1
			time-to-max-speed-ms = <300>;// 40
			delay-ms = <0>;// 0
		};
		msc {
			acceleration-exponent = <0>;// 0
			time-to-max-speed-ms = <40>;// 500
			delay-ms = <0>;// 10
		};
	};
	
	conditional_layers {
		compatible = "zmk,conditional-layers";
		
		tri_layer {
			if-layers = <RIG LEF>;
			then-layer = <TRI>;
		};
	};

	combos {
		compatible = "zmk,combos";

		combo_er_right_click {
			timeout-ms = <25>;
			require-prior-idle-ms = <125>;
			key-positions = <2 3>;
			layers = <MAC WIN MOUSE>;
			bindings = <&mkp RCLK>;
		};

		combo_rt_forward {
			timeout-ms = <25>;
			require-prior-idle-ms = <125>;
			key-positions = <3 4>;
			layers = <MAC WIN MOUSE>;
			bindings = <&mkp MB5>;
		};

		combo_df_left_click {
			timeout-ms = <25>;
			require-prior-idle-ms = <125>;
			key-positions = <12 13>;
			layers = <MAC WIN MOUSE>;
			bindings = <&mkp LCLK>;
		};

		combo_fg_back {
			timeout-ms = <25>;
			require-prior-idle-ms = <125>;
			key-positions = <13 14>;
			layers = <MAC WIN MOUSE>;
			bindings = <&mkp MB4>;
		};

		combo_cv_middle_click {
			timeout-ms = <25>;
			require-prior-idle-ms = <125>;
			key-positions = <22 23>;
			layers = <MAC WIN MOUSE>;
			bindings = <&mkp MCLK>;
		};
	};
	
	keymap {
		compatible = "zmk,keymap";
		
		default_layer {
			display-name = "DEF";
			bindings = <
			&ht LS(Q) Q      &ht LS(W) W      &ht LS(E) E      &ht LS(R) R      &ht LS(T) T      &ht LS(Y) Y      &ht LS(U) U      &ht LS(I) I          &ht LS(O) O        &ht LS(P) P
			&ht LS(A) A      &ht LS(S) S      &ht LS(D) D      &ht LS(F) F      &ht LS(G) G      &ht LS(H) H      &ht LS(J) J      &ht LS(K) K          &ht LS(L) L        &ht LS(SEMI) SEMI
			&ht LS(Z) Z      &ht LS(X) X      &ht LS(C) C      &ht LS(V) V      &ht LS(B) B      &ht LS(N) N      &ht LS(M) M      &ht LS(COMMA) COMMA  &ht LS(DOT) DOT    &ht LS(SQT) SQT
			&kp C_MUTE       &lt RIG LGUI     &kp SPACE        &kp ENTER        &lt WIN LG(SPACE)    &studio_unlock
			>;
			sensor-bindings = <&inc_dec_kp C_VOL_DN C_VOL_UP &inc_dec_kp C_BRI_DEC C_BRI_UP>;
		};
		
		windows_layer {
			display-name = "WIN";
			bindings = <
			&kp ESC              &kp F1          &kp F2          &kp F3           &kp F4      &kp RC(GRAVE)    &kp LC(LS(F10))  &kp UP      &kp LC(LA(F9))  &kp F10
			&ht LS(GRAVE) GRAVE  &ht LSHIFT F5   &ht LALT F6     &ht LCTRL F7     &kp F8      &kp LC(LS(F12))  &kp LEFT         &kp DOWN    &kp RIGHT       &kp F12
			&kp TAB              &kp F9          &kp F10         &kp F11          &kp F12     &kp LC(C)        &kp LC(X)        &kp LC(V)   &kp LS(INS)     &kp RSHIFT
			&kp C_MUTE           &kp LA(LCTRL)   &kp SPACE       &kp ENTER        &lt RIG TAB  &studio_unlock
			>;
			sensor-bindings = <&inc_dec_kp C_VOL_DN C_VOL_UP &inc_dec_kp C_BRI_DEC C_BRI_UP>;
		};
		
		right_layer {
			display-name = "NUM";
			bindings = <
			&ht LS(N1) N1        &ht LS(N2) N2        &ht LS(N3) N3      &ht LS(N4) N4        &ht LS(N5) N5        &kp PSCRN            &kp INS              &kp LC(UP)           &kp DEL              &kp BSPC
			&ht LS(N6) N6        &ht LS(N7) N7        &ht LS(N8) N8      &ht LS(N9) N9        &ht LS(N0) N0        &kp PG_UP            &kp LC(LEFT)         &kp LC(DOWN)         &kp LC(RIGHT)        &kp HOME
			&ht LS(EQUAL) EQUAL  &ht LS(MINUS) MINUS  &ht LS(LBKT) LBKT  &ht LS(RBKT) RBKT    &ht LS(FSLH) FSLH    &kp PG_DN            &ht LS(BSLH) BSLH    &ht LS(GRAVE) GRAVE  &kp LS(INS)          &kp END
			&kp C_MUTE           &kp LA(LCTRL)        &kp ESC            &kp LSHIFT           &kp LCTRL            &studio_unlock
			>;
			sensor-bindings = <&inc_dec_kp C_VOL_DN C_VOL_UP &inc_dec_kp C_BRI_DEC C_BRI_UP>;
		};
		
		left_layer {
			display-name = "SYM";
			bindings = <
			&kp EXCL  &kp AT    &kp HASH  &kp DLLR  &kp PRCNT    &kp CARET  &kp AMPS   &kp ASTRK  &kp GRAVE  &kp TILDE
			&kp DQT   &kp LBKT  &kp LBRC  &kp LPAR  &default_report     &kp FSLH   &kp MINUS  &kp EQUAL  &kp COLON  &kp SEMI
			&kp SQT   &kp RBKT  &kp RBRC  &kp RPAR  &trans   &kp BSLH   &kp UNDER  &kp PLUS   &kp PIPE   &kp QMARK
			&kp C_MUTE &trans    &trans       &tog MOUSE     &trans  &studio_unlock
			>;
			sensor-bindings = <&inc_dec_kp C_VOL_DN C_VOL_UP &inc_dec_kp C_BRI_DEC C_BRI_UP>;
		};
		
		tri_layer {
			display-name = "FUN";
			bindings = <
			&kp F1  &kp F2   &kp F3   &kp F4   &bt BT_SEL 0    &bt BT_SEL 2  &out OUT_TOG   &tog WIN  &kp C_MUTE    &kp C_PREV
			&kp F5  &kp F6   &kp F7   &kp F8   &bt BT_SEL 1    &bt BT_SEL 3  &kp C_BRI_UP   &studio_unlock    &kp C_VOL_UP  &kp C_PP
			&kp F9  &kp F10  &kp F11  &kp F12  &bt BT_CLR      &bt BT_SEL 4  &kp C_BRI_DEC  &soft_off     &kp C_VOL_DN  &kp C_NEXT
			&kp C_MUTE  &trans   &trans          &trans        &trans  &studio_unlock
			>;
			sensor-bindings = <&inc_dec_kp C_VOL_DN C_VOL_UP &inc_dec_kp C_BRI_DEC C_BRI_UP>;
		};
	
		mouse {
			display-name = "MOUSE";
			bindings = <
			&tog MOUSE  &mkp MB4  &mkp MCLK  &mkp MB5   &trans      &msc SCRL_LEFT     &msc SCRL_DOWN    &msc SCRL_UP     &msc SCRL_RIGHT    &tog MOUSE
			&trans      &trans    &trans     &trans     &trans      &mmv MOVE_LEFT     &mmv MOVE_DOWN    &mmv MOVE_UP     &mmv MOVE_RIGHT    &trans
			&ptr_spd SPEED_POINTER SPEED_FINE_PREV  &ptr_spd SPEED_POINTER SPEED_FINE_NEXT  &ptr_spd SPEED_SCROLL SPEED_FINE_PREV  &ptr_spd SPEED_SCROLL SPEED_FINE_NEXT  &crq_mode CIRQUE_MODE_TOGGLE        &trans     &mkp MB4  &mkp MCLK  &mkp MB5  &trans
			&ptr_spd SPEED_POINTER SPEED_RESET &kp SPACE  &kp LSHIFT  &mkp LCLK  &mkp RCLK &ptr_spd SPEED_SCROLL SPEED_RESET
			>;
			sensor-bindings = <&enc_ptr_spd &enc_scrl_spd>;
		};
	};
};
